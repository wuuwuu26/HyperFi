[Unit]
Description=HyperFi Music Server
Documentation=https://github.com/wuuwuu26/HyperFi
After=network.target

[Service]
Type=simple
User=hyperfi-server
Group=hyperfi-server
WorkingDirectory=/usr/lib/hyperfi-server
ExecStart=/usr/lib/hyperfi-server/HyperFi.Server
# systemd creates /var/lib/hyperfi-server owned by the service user; the server
# stores its database, caches, and downloaded artwork there. Without a writable
# data directory the --no-create-home service user cannot create the SQLite
# database under $HOME and the process aborts on startup.
StateDirectory=hyperfi-server
Environment=HYPERFI_DATA_DIR=/var/lib/hyperfi-server
# Keep long ReplayGain maintenance subordinate to SSH, Kestrel, and normal
# system activity. Administrators may override these values in the environment file.
Environment=HyperFi__ReplayGainFfmpegThreads=1
Environment=HyperFi__ReplayGainDelayMilliseconds=250
EnvironmentFile=-/etc/default/hyperfi-server
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hyperfi-server

[Install]
WantedBy=multi-user.target
