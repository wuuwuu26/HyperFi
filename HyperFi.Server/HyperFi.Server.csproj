<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HyperFi.Server</AssemblyName>
    <RootNamespace>HyperFi.Server</RootNamespace>
    <Product>HyperFi Server</Product>
    <Authors>HyperFi contributors, Björn Schlaack</Authors>
    <Copyright>Copyright © 2026 HyperFi contributors; original Orynivo code © 2026 Björn Schlaack</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wuuwuu26/HyperFi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <UpdatePublicKeyBase64 Condition="'$(UpdatePublicKeyBase64)' == ''"></UpdatePublicKeyBase64>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HyperFiUpdatePublicKey</_Parameter1>
      <_Parameter2>$(UpdatePublicKeyBase64)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <ProjectReference Include="..\HyperFi.Core\HyperFi.Core.csproj" />
  </ItemGroup>

</Project>
